# Set this to production on Render. Omit it locally to keep development defaults.
NODE_ENV=production

# Server port supplied by the hosting platform (Render provides PORT).
PORT=3001

# Exact browser origin allowed by the backend, without a trailing slash.
FRONTEND_URL=https://your-frontend.vercel.app

# Deployed n8n base URL and server-only API key.
N8N_BASE_URL=https://your-n8n.example.com
N8N_API_KEY=replace-with-n8n-api-key

# Server-only Google OAuth configuration.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend.example.com/oauth/callback

# Server-only Supabase configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# 32-byte hexadecimal key used for encrypted Gmail tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-character-key
